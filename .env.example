# --- Local development (Docker Postgres from docker-compose.yml) ---
# Copy this file to `.env` (git-ignored) to run locally.
DATABASE_URL=postgres://kanban:kanban@localhost:5432/kanban
# Driver: "pg" for local Docker Postgres, "neon" for the Neon pooled endpoint.
DATABASE_DRIVER=pg

# Auth.js v5 session/JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me

# The service worker and the install prompt only run against a production build
# (`npm run build && npm start`), which is also the only way to demo offline.
# Auth.js refuses to trust the request host outside `next dev` unless told to —
# Vercel sets this for you, a local production run doesn't.
AUTH_TRUST_HOST=true

# --- Production (Vercel + Neon) — set these in the Vercel dashboard ---
# Use Neon's POOLED endpoint (host contains "-pooler"), required by design decision D4.
# DATABASE_URL=postgres://<user>:<pass>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# DATABASE_DRIVER=neon
